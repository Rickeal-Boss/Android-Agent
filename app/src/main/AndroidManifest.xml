<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- = -->
    <!-- 权限                                                              -->
    <!-- = -->

    <!-- Wave4 六路审查（F-P0-1 / D-P1-2）：应用已收敛为纯端侧推理，远程引擎与云端 API
         已整体移除（commit 71dc6e5），此前声明的 INTERNET + usesCleartextTraffic 是
         去云端漏网残留 —— 删。模型下载走系统 DownloadManager（下载发生在系统进程，
         请求方 App 不需要持有 INTERNET 权限），工具面已零网络能力。
         arch-guard 第 7 条守卫会断言本文件不再出现 INTERNET / usesCleartextTraffic。 -->

    <!-- 计量网络判定（ConnectivityManager.activeNetwork）：驱动「正在使用移动数据」
         下载确认弹窗。**不可删** —— 删掉后 activeNetwork 返回 null，AppContainer.
         isMeteredNetwork() 的 `?: return true`（fail-open，方向安全：宁可多问一次）
         会在 Wi-Fi 下也命中，用户每次下载都被误弹流量确认。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 存储权限：本应用**刻意不申请任何存储权限**。
         模型与附件的读取全部走系统文件选择器（ACTION_OPEN_DOCUMENT），由用户显式授权，
         既不需要运行时权限，也不会触发应用商店对敏感权限的审核。
         下载的模型落在应用专属目录（getExternalFilesDir），同样无需权限。

         注意：READ_EXTERNAL_STORAGE 在 Android 11（API 30）之后**已无法读取非媒体文件**
         （.litertlm / .task 不属于图片/音视频），在 API 33+ 更是被细分的媒体权限取代。
         声明它既无用、又会让用户在安装时看到一项申请了却用不到的权限，故移除。 -->

    <!-- 端侧 4B 模型：读写 .litertlm / .task 需要较大的可用内存 -->

    <!-- 关闭自动备份（Auto Backup）：
         filesDir 下存着两类不该上云的数据 ——
           1. 用户会话全文（conversations/*.json，隐私）；
           2. GB 级模型文件（models/，远超 25MB 备份上限，会导致备份失败并浪费用户云端配额）。
         端侧优先 + 隐私优先，这里整体关闭；将来若需要换机迁移，应提供显式的导出/导入，
         而不是依赖系统静默备份。 -->
    <application
        android:name=".LiquidAgentApplication"
        android:allowBackup="false"
        android:appCategory="productivity"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiquidAgent"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="user"
            android:theme="@style/Theme.LiquidAgent"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
