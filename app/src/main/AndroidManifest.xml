<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- = -->
    <!-- 权限                                                              -->
    <!-- = -->

    <!-- INTERNET（Wave 12 修订，真机实锤）：系统 DownloadManager 的 enqueue() 要求
         **请求方 App 持有 INTERNET 权限**——Wave 4 注释里「下载发生在系统进程，
         请求方不需要 INTERNET」的判断是错的（AOSP DownloadProvider 会校验调用方权限，
         无权限时 enqueue 抛 SecurityException，被 ModelDownloader.runCatching 吞成 null，
         UI 表现为「无法启动下载：系统下载服务不可用」——模型直链下载在真机上从未成功过）。
         权限用途**仅限**模型文件下载（下载源全部 https，见 Wave 6 换源口径）。
         纯端侧承诺的实质在代码面，不在权限面：全仓禁网络栈 + 禁进程执行
         （arch-guard 第 5/6 条守卫不变），推理零数据外发。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 计量网络判定（ConnectivityManager.activeNetwork）：驱动「正在使用移动数据」
         下载确认弹窗。**不可删** —— 删掉后 activeNetwork 返回 null，AppContainer.
         isMeteredNetwork() 的 `?: return true`（fail-open，方向安全：宁可多问一次）
         会在 Wi-Fi 下也命中，用户每次下载都被误弹流量确认。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 本地通知（Wave 9 需求 5「生成速度通知」）：通知内容由端侧推理速度
         （token/s 与首字延迟）渲染于系统 UI，无任何网络传输 —— 内容全部产自本机
         模型运行时的计时器，不携带会话正文。用户拒绝授权时**静默降级**：
         不持久化开关、不出通知，端侧推理功能本身完全不受影响。
         API 33+ 为运行时权限，仅在用户显式打开 App 内开关时才请求。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 存储权限：本应用**刻意不申请任何存储权限**。
         模型与附件的读取全部走系统文件选择器（ACTION_OPEN_DOCUMENT），由用户显式授权，
         既不需要运行时权限，也不会触发应用商店对敏感权限的审核。
         下载的模型落在应用专属目录（getExternalFilesDir），同样无需权限。

         注意：READ_EXTERNAL_STORAGE 在 Android 11（API 30）之后**已无法读取非媒体文件**
         （.litertlm / .task 不属于图片/音视频），在 API 33+ 更是被细分的媒体权限取代。
         声明它既无用、又会让用户在安装时看到一项申请了却用不到的权限，故移除。 -->

    <!-- 端侧 4B 模型：读写 .litertlm / .task 需要较大的可用内存 -->

    <!-- 关闭自动备份（Auto Backup）：
         filesDir 下存着两类不该上云的数据 ——
           1. 用户会话全文（conversations/*.json，隐私）；
           2. GB 级模型文件（models/，远超 25MB 备份上限，会导致备份失败并浪费用户云端配额）。
         端侧优先 + 隐私优先，这里整体关闭；将来若需要换机迁移，应提供显式的导出/导入，
         而不是依赖系统静默备份。
         ⚠️ 注意：allowBackup 自 Android 12（API 31）起被 dataExtractionRules 取代 ——
         只写 allowBackup 已不足以表达「不许出设备」，故下方 application 补挂
         dataExtractionRules（见 res/xml/data_extraction_rules.xml），两者同口径、缺一不可。 -->
    <!-- supportsRtl 已移除（Wave 32，诚实性修正）：res/values/strings.xml 只有 1 条串
         （app_name），Composable 里 ~145 处中文硬编码，RTL 布局从未被验证、也无从验证 ——
         在完整 i18n 完成前不声明 RTL。挂账见 README「挂账台账」节。 -->
    <application
        android:name=".LiquidAgentApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:appCategory="productivity"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.LiquidAgent">

        <!-- LiteRT-LM GPU 后端的原生库声明（2026-09-26，真机实锤的引擎加载失败根修）：
             GPU 委托（libLiteRtClGlAccelerator.so，随 litertlm-android AAR 打包）需要
             dlopen 厂商提供的 OpenCL 库 —— 它是**非 NDK 库**，targetSdk ≥ 31 时应用
             必须在清单里逐个声明才能访问（Android 12 行为变更），否则 dlopen 直接失败，
             CompiledModel::Create 抛 INTERNAL（真机报错定位
             llm_litert_compiled_model_executor.cc:1928）。官方 getting-started 文档
             要求的就是这三条声明（LiteRT-LM issue #1860 同款案例）。required=false：
             设备没有 OpenCL（如 Tensor G3）时不阻止安装，引擎侧另有 GPU→CPU 自动降级。 -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL-car.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL-pixel.so"
            android:required="false" />

        <!-- Wave 38：原 `screenOrientation="user"` 被 lint 判为 DiscouragedApi；
             `user` 与默认 `unspecified` 在手机上对「跟随用户旋转锁」的行为等价
             （两者都尊重系统自动旋转与用户锁定），而 Android 16 起大屏本就忽略固定方向，
             故移除显式声明、交由系统默认。真机需复验旋转与旋转锁表现。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LiquidAgent"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 沙箱文件「打开」动作的 URI 桥（Wave 33「沙箱文件可视 + 跳转打开」）：
             filesDir/agent_sandbox 下的文件无法以 file:// 直接交给外部应用
             （targetSdk ≥ 24 上 FileUriExposedException），必须经 FileProvider
             换成 content:// 并按需授权。
             exported=false + grantUriPermissions=true：provider 本身不对组件外暴露，
             只在 Intent 携带 FLAG_GRANT_READ_URI_PERMISSION 时对目标应用临时授予
             **只读**权限（本应用从不发起写授权）——这是 FileProvider 的标准安全形态。
             暴露面被 file_paths.xml 收窄到 `files-path agent_sandbox/` 一个子目录：
             conversations / models / 记忆等其余 filesDir 内容（隐私与用户资产）
             不进 provider 路径表，物理上不可被经此 URI 读取。
             authorities 用 ${applicationId} 占位：debug 构建带 .debug 后缀时
             无需改代码即自动对齐，避免「装了两包、authority 冲突」。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
